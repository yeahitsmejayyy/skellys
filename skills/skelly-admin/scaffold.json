{
  "id": "admin",
  "repo": "https://github.com/yeahitsmejayyy/skelly-admin",
  "dir": "admin",
  "summary": "Vite + React admin portal, typed against the backend over tRPC.",
  "run": "bun install && bun run dev",
  "rename": [
    {
      "file": "package.json",
      "from": "@skelly/frontend",
      "to": "@{{slug}}/admin"
    },
    {
      "file": "index.html",
      "from": "@skelly/admin",
      "to": "@{{slug}}/admin"
    },
    {
      "file": "src/components/layout/app-nav.tsx",
      "from": "skelly-admin",
      "to": "{{slug}}-admin"
    },
    {
      "file": "src/components/layout/app-nav.tsx",
      "from": "username=\"yeahitsmejayyy\"",
      "to": "username=\"{{slug}}\""
    },
    {
      "file": "src/components/layout/app-nav.tsx",
      "from": "email=\"hello@itsjayyy.com\"",
      "to": "email=\"you@example.com\""
    },
    {
      "file": "src/components/layout/app-nav.tsx",
      "from": "avatarSrc=\"/avatar.png\"",
      "to": "avatarSrc=\"\""
    },
    {
      "file": "src/lib/app-router.d.ts",
      "from": "skelly-backend's",
      "to": "the backend's"
    },
    {
      "file": "scripts/sync-types.ts",
      "from": "  Clone skelly-backend beside this repo, or set SKELLY_BACKEND=/path/to/skelly-backend.",
      "to": "  Clone the backend beside this repo, or set BACKEND_DIR=/path/to/backend."
    },
    {
      "file": "scripts/sync-types.ts",
      "from": "from skelly-backend's src/appRouter.ts",
      "to": "from the backend's src/appRouter.ts"
    },
    {
      "file": "scripts/sync-types.ts",
      "from": "\"../skelly-backend\"",
      "to": "\"../backend\""
    },
    {
      "file": "scripts/sync-types.ts",
      "from": "SKELLY_BACKEND",
      "to": "BACKEND_DIR"
    }
  ],
  "purge": [
    "README.md",
    "SECURITY.md",
    "ARCHITECTURE.md",
    "image.png",
    "LICENSE",
    "public/avatar.png"
  ],
  "demo": []
}
